---
import FilterBar from "@/components/FilterBar.astro";
import Layout from "@/components/Layout.astro";
import ListingCard from "@/components/ListingCard.astro";
import SearchBox from "@/components/SearchBox.astro";
import { getDirectoryData } from "@/lib/airtable";

const data = await getDirectoryData();
---

<Layout
  title="Supermarket Directory Singapore"
  description="Browse all published supermarket outlets in Singapore with filters for brand, neighbourhood, category, MRT station, and mall."
  canonical="/directory"
>
  <section class="container-page py-16">
    <div class="max-w-4xl">
      <p class="eyebrow">Directory</p>
      <h1 class="mt-4 font-serif text-6xl leading-none sm:text-7xl">All supermarkets in Singapore</h1>
      <p class="mt-6 text-lg leading-8 text-muted">
        Singapore's supermarket scene is a thriving mix of local and international chains catering to diverse tastes, budgets, and lifestyles.Singapore's supermarket scene is a thriving mix of local and international chains catering to diverse tastes, budgets, and lifestyles. Whether you're a busy professional, a family stocking up for the week, or a visitor looking for everyday essentials, there is a supermarket in Singapore to meet your needs. Major players include FairPrice (the dominant homegrown cooperative), Cold Storage and Giant (both under Dairy Farm International), and Sheng Siong. Hypermarkets like Giant Hypermarket also offer bulk shopping options, making it easy to get everything under one roof.
      </p>
      <p class="mt-6 text-lg leading-8 text-muted">
        Conveniently located near MRT stations, bus interchanges, and HDB heartland estates, Singapore's supermarkets are designed with accessibility in mind. Many outlets operate 24/7 or maintain extended hours, catering to Singapore's fast-paced lifestyle and ensuring that groceries are always within easy reach — no matter the time of day. With a supermarket scene this comprehensive and well-distributed across the island, grocery shopping in Singapore is as seamless and convenient as it gets.
      </p>
      <div class="mt-8">
        <SearchBox compact />
      </div>
    </div>
  </section>

  <section class="container-page pb-8">
    <FilterBar data={data} outlets={data.supermarkets} />
  </section>

  <section
    class="container-page grid gap-5 pb-20 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4"
    data-pagefind-body
    data-pagefind-meta="title:Singapore Supermarket Directory"
  >
    {data.supermarkets.map((outlet) => <ListingCard outlet={outlet} />)}
  </section>
</Layout>
