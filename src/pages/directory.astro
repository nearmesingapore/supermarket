---
import FilterBar from "@/components/FilterBar.astro";
import Layout from "@/components/Layout.astro";
import ListingCard from "@/components/ListingCard.astro";
import SearchBox from "@/components/SearchBox.astro";
import { getDirectoryData } from "@/lib/airtable";

const data = await getDirectoryData();
const outletGroups = [
  { outlets: data.supermarkets, basePath: "/supermarkets" },
  { outlets: data.groceryStores, basePath: "/grocery-stores" },
  { outlets: data.convenienceStores, basePath: "/convenience-stores" },
  { outlets: data.generalStores, basePath: "/general-stores" }
];
const outlets = outletGroups.flatMap((group) => group.outlets);
---

<Layout
  title="Supermarkets and Grocery Stores in Singapore"
  description="Find supermarkets and grocery stores in Singapore, from major chains and premium retailers to organic stores, ethnic supermarkets, and neighbourhood provision shops."
  canonical="/directory"
>
  <section class="container-page py-16">
    <div class="max-w-4xl">
      <p class="eyebrow">Directory</p>
      <h1 class="mt-4 font-serif text-6xl leading-none sm:text-7xl">Supermarkets and Grocery Stores in Singapore</h1>
      <p class="page-intro mt-6">
        Singapore's diverse food culture is reflected in its wide variety of supermarkets and grocery stores, catering to every lifestyle, budget, and culinary preference.
      </p>
      <p class="page-intro mt-6">
        From large-format chains like NTUC FairPrice, Cold Storage, and Giant offering everyday essentials, to premium retailers like Jason's Market Place and Marketplace stocking imported and specialty goods — there's something for everyone.
      </p>
      <p class="page-intro mt-6">
        Health-conscious shoppers will find dedicated organic and natural stores such as Ryan's Grocery and The Little Farms, while ethnic-focused supermarkets like Mustafa Centre and Sheng Siong offer an extensive range of regional and international products.
      </p>
      <p class="page-intro mt-6">
        Whether you're hunting for a neighbourhood provision shop, a 24-hour supermarket, or a specialty grocer for your weekly haul, this directory helps you find the right store — wherever you are on the island.
      </p>
      <div class="mt-8">
        <SearchBox compact label="Search supermarkets and grocery stores" />
      </div>
    </div>
  </section>

  <section class="container-page pb-8">
    <FilterBar data={data} outlets={outlets} />
  </section>

  <section
    class="container-page grid gap-5 pb-20 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4"
    data-pagefind-body
    data-pagefind-meta="title:Singapore Supermarket Directory"
    data-filter-results
  >
    {outletGroups.map((group) =>
      group.outlets.map((outlet) => <ListingCard outlet={outlet} basePath={group.basePath} />)
    )}
  </section>
</Layout>
