---
import Layout from "@/components/Layout.astro";
---

<Layout
  title="Page Not Found"
  description="This supermarket.sg page does not exist or is no longer available."
  canonical="/404"
  robots="noindex, follow"
>
  <section class="container-page py-16 sm:py-20" data-pagefind-ignore>
    <p class="eyebrow">404</p>
    <h1 class="mt-4 font-serif text-5xl leading-none text-ink sm:text-7xl">Page not found</h1>
    <p class="mt-6 max-w-2xl text-lg leading-8 text-muted">
      The page you are looking for does not exist or is no longer available. Browse current supermarket promotions or return to the directory.
    </p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a class="soft-button w-full sm:w-auto" href="/promotions/">View promotions</a>
      <a class="ghost-button w-full sm:w-auto" href="/directory/">Browse directory</a>
    </div>
  </section>
</Layout>
