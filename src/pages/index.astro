---
import BrandCard from "@/components/BrandCard.astro";
import HeroSection from "@/components/HeroSection.astro";
import Layout from "@/components/Layout.astro";
import ListingCard from "@/components/ListingCard.astro";
import NeighbourhoodCard from "@/components/NeighbourhoodCard.astro";
import { getDirectoryData } from "@/lib/airtable";
import { sortFeaturedNeighbourhoods } from "@/lib/content";
const data = await getDirectoryData();
const featuredNeighbourhoods = sortFeaturedNeighbourhoods(data.neighbourhoods).slice(0, 10);
---
<Layout title="Singapore Supermarket Directory" description="Discover supermarkets across Singapore by neighbourhood, brand, mall, and MRT station." canonical="/"><HeroSection /><section class="container-page py-20" data-pagefind-body data-pagefind-meta="title:Singapore Supermarket Directory"><div class="flex flex-col justify-between gap-5 md:flex-row md:items-end"><div><p class="eyebrow">Featured Neighbourhoods</p><h2 class="section-title mt-3">Browse by neighbourhood</h2></div><a class="fine-link text-sm font-semibold" href="/neighbourhoods/">View all neighbourhoods</a></div><div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">{featuredNeighbourhoods.map((neighbourhood) => <NeighbourhoodCard neighbourhood={neighbourhood} />)}</div></section><section class="border-y border-line bg-white py-20"><div class="container-page"><div class="flex flex-col justify-between gap-5 md:flex-row md:items-end"><div><p class="eyebrow">Featured Brands</p><h2 class="section-title mt-3">Explore Singapore supermarket brands</h2></div><a class="fine-link text-sm font-semibold" href="/brands/">View all brands</a></div><div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">{data.brands.map((brand) => <BrandCard brand={brand} />)}</div></div></section>{data.featuredSupermarkets.length > 0 && <section class="container-page py-20"><p class="eyebrow">Featured Supermarkets</p><h2 class="section-title mt-3">Curated outlets to know</h2><div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">{data.featuredSupermarkets.map((outlet) => <ListingCard outlet={outlet} />)}</div></section>}</Layout>
