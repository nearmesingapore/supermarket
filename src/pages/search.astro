---
import Layout from "@/components/Layout.astro";
---
<Layout title="Search Singapore Supermarkets" description="Search supermarket outlets, brands, neighbourhoods, malls, MRT stations, and addresses across Singapore." canonical="/search"><section class="container-page py-16" data-pagefind-body data-pagefind-meta="title:Search Singapore Supermarkets"><p class="eyebrow">Search</p><h1 class="mt-4 font-serif text-6xl leading-none sm:text-7xl">Search the directory</h1><p class="mt-6 max-w-2xl text-lg leading-8 text-muted">Search by outlet name, brand, neighbourhood, MRT station, mall, address, or postal code.</p><div class="mt-10 max-w-3xl border border-line bg-white p-4"><div id="search"></div></div></section><link href="/pagefind/pagefind-ui.css" rel="stylesheet" /><script is:inline src="/pagefind/pagefind-ui.js"></script><script is:inline>window.addEventListener("DOMContentLoaded",()=>{if(!window.PagefindUI)return;const params=new URLSearchParams(window.location.search);new window.PagefindUI({element:"#search",showSubResults:true,showImages:false});const query=params.get("q");if(query){const input=document.querySelector("#search input");if(input){input.value=query;input.dispatchEvent(new Event("input",{bubbles:true}));}}});</script></Layout>
