---
import Layout from "@/components/Layout.astro";
import MallCard from "@/components/MallCard.astro";
import { getDirectoryData } from "@/lib/airtable";

const data = await getDirectoryData();
---

<Layout title="Singapore Supermarket Malls" description="Browse supermarkets by mall and shopping location across Singapore." canonical="/malls">
  <section class="container-page py-16" data-pagefind-body data-pagefind-meta="title:Singapore Supermarket Malls">
    <p class="eyebrow">Malls</p>
    <h1 class="page-title mt-4">Browse by mall</h1>
    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {data.malls.map((mall) => <MallCard mall={mall} />)}
    </div>
  </section>
</Layout>
