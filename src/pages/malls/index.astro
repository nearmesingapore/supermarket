---
import Layout from "@/components/Layout.astro";
import TaxonomyCard from "@/components/TaxonomyCard.astro";
import { getDirectoryData } from "@/lib/airtable";

const data = await getDirectoryData();
---

<Layout title="Singapore Supermarket Malls" description="Browse supermarkets by Singapore mall and shopping location." canonical="/malls"><section class="container-page py-16" data-pagefind-body data-pagefind-meta="title:Singapore Supermarket Malls"><p class="eyebrow">Malls</p><h1 class="mt-4 font-serif text-6xl leading-none sm:text-7xl">Browse by mall</h1><div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">{data.malls.map((mall) => <TaxonomyCard item={mall} href={`/malls/${mall.slug}`} label="Mall / Location" />)}</div></section></Layout>
