---
import Layout from "@/components/Layout.astro";
import ListingCard from "@/components/ListingCard.astro";
import { getDirectoryData, type TaxonomyItem } from "@/lib/airtable";
import { formatCount, pageDescription } from "@/lib/content";
export async function getStaticPaths() { const data = await getDirectoryData(); return data.malls.map((mall) => ({ params: { slug: mall.slug }, props: { mall } })); }
const { mall } = Astro.props as { mall: TaxonomyItem };
const data = await getDirectoryData();
const outlets = data.supermarkets.filter((outlet) => outlet.mall.some((item) => item.id === mall.id));
const title = `${mall.name} Supermarkets`;
---
<Layout title={title} description={pageDescription(title, outlets.length)} canonical={`/malls/${mall.slug}`}><section class="container-page py-16" data-pagefind-body data-pagefind-meta={`title:${title}`}><p class="eyebrow">Mall / Location</p><h1 class="mt-4 font-serif text-6xl leading-none sm:text-7xl">{mall.name}</h1><p class="mt-6 text-lg text-muted">{formatCount(outlets.length, "published outlet")}</p></section><section class="container-page grid gap-5 pb-20 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">{outlets.map((outlet) => <ListingCard outlet={outlet} />)}</section></Layout>
