---
import Layout from "@/components/Layout.astro";
import NeighbourhoodCard from "@/components/NeighbourhoodCard.astro";
import { getDirectoryData } from "@/lib/airtable";
import { sortFeaturedNeighbourhoods } from "@/lib/content";
const data = await getDirectoryData();
const neighbourhoods = sortFeaturedNeighbourhoods(data.neighbourhoods);
---
<Layout title="Singapore Supermarket Neighbourhoods" description="Browse supermarkets by Singapore neighbourhood, from Woodlands and Tampines to Bedok, Punggol, Jurong East, and more." canonical="/neighbourhoods"><section class="container-page py-16" data-pagefind-body data-pagefind-meta="title:Singapore Supermarket Neighbourhoods"><p class="eyebrow">Neighbourhoods</p><h1 class="page-title mt-4">Browse by neighbourhood</h1><div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">{neighbourhoods.map((neighbourhood) => <NeighbourhoodCard neighbourhood={neighbourhood} />)}</div></section></Layout>
