---
import Layout from "@/components/Layout.astro";
import PromotionCard from "@/components/PromotionCard.astro";
import { getBrandPromotions, getDirectoryData, type PromotionCollection } from "@/lib/airtable";
import { formatCount } from "@/lib/content";

export async function getStaticPaths() {
  const data = await getDirectoryData();
  return data.promotionCollections.map((collection) => ({
    params: { promotionCollection: collection.slug },
    props: { collection }
  }));
}

const { collection } = Astro.props as { collection: PromotionCollection };
const data = await getDirectoryData();
const brand = data.brands.find((item) => item.slug === collection.brandSlug);
const promotions = brand ? getBrandPromotions(data.promotions, brand.id) : [];
const supermarketOutlets = brand
  ? data.supermarkets
      .filter((outlet) => outlet.brand.some((item) => item.id === brand.id))
      .sort((a, b) => a.outletName.localeCompare(b.outletName))
  : [];
const groceryStoreOutlets = brand
  ? data.groceryStores
      .filter((outlet) => outlet.brand.some((item) => item.id === brand.id))
      .sort((a, b) => a.outletName.localeCompare(b.outletName))
  : [];
const outletCount = supermarketOutlets.length + groceryStoreOutlets.length;
const title = collection.label;
const description = `Browse current ${collection.label.toLowerCase()} in Singapore, with links to ${brand?.name || "brand"} outlet pages and full promotion details.`;
---

<Layout title={title} description={description} image={brand?.imageUrl} canonical={`/${collection.slug}`}>
  <section class="container-page py-16" data-pagefind-body data-pagefind-meta={`title:${title};brand:${brand?.name || ""}`}>
    <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-end">
      <div>
        <p class="eyebrow">Promotions</p>
        <h1 class="page-title mt-4">{title}</h1>
        <p class="page-intro mt-6 max-w-3xl">{description}</p>
      </div>
      {brand && <a class="fine-link text-sm font-semibold" href={`/brands/${brand.slug}`}>{brand.name} brand page</a>}
    </div>

    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {promotions.map((promotion) => <PromotionCard promotion={promotion} />)}
    </div>
  </section>

  {outletCount > 0 && (
    <section class="border-t border-line bg-white py-16">
      <div class="container-page">
        <div>
          <p class="eyebrow">Outlet links</p>
          <h2 class="section-title mt-3">{brand?.name} outlets with relevant promotions</h2>
          <p class="mt-4 text-sm text-muted">{formatCount(outletCount, "outlet")} linked from this promotions page.</p>
        </div>
        <div class="mt-8 columns-1 gap-8 text-sm leading-7 sm:columns-2 lg:columns-3">
          {supermarketOutlets.map((outlet) => (
            <a class="fine-link mb-2 block break-inside-avoid" href={`/supermarkets/${outlet.slug}`}>{outlet.outletName}</a>
          ))}
          {groceryStoreOutlets.map((outlet) => (
            <a class="fine-link mb-2 block break-inside-avoid" href={`/grocery-stores/${outlet.slug}`}>{outlet.outletName}</a>
          ))}
        </div>
      </div>
    </section>
  )}
</Layout>
