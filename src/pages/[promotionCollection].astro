---
import Layout from "@/components/Layout.astro";
import PromotionCard from "@/components/PromotionCard.astro";
import { getBrandPromotions, getDirectoryData, type PromotionCollection } from "@/lib/airtable";
import { formatCount } from "@/lib/content";
import { buildFaqPageSchema, type BrandFaqItem } from "@/lib/faq";
import { canonicalPath } from "@/lib/seo";

export async function getStaticPaths() {
  const data = await getDirectoryData();
  return data.promotionCollections.map((collection) => ({
    params: { promotionCollection: collection.slug },
    props: { collection }
  }));
}

const { collection } = Astro.props as { collection: PromotionCollection };
const data = await getDirectoryData();
const brand = data.brands.find((item) => item.slug === collection.brandSlug);
const promotions = brand ? getBrandPromotions(data.promotions, brand.id) : [];
const outletCount = brand
  ? [...data.supermarkets, ...data.groceryStores].filter((outlet) => outlet.brand.some((item) => item.id === brand.id)).length
  : 0;
const isShengSiongPage = collection.slug === "sheng-siong-promotions";
const isFairPricePage = collection.slug === "fairprice-promotions";
const isGiantPage = collection.slug === "giant-promotions";
const hasSeoArticle = isShengSiongPage || isFairPricePage || isGiantPage;
const title = isShengSiongPage
  ? "Sheng Siong Promotions"
  : isFairPricePage
    ? "FairPrice Promotions – NTUC FairPrice Deals Updated Weekly"
    : isGiantPage
      ? "Giant Promotions – Giant Supermarket Deals Updated Weekly"
    : collection.label;
const description = isShengSiongPage
  ? "Browse all current Sheng Siong promotions today in Singapore."
  : isFairPricePage
    ? "Browse all current NTUC FairPrice promotions in Singapore. Updated weekly with the latest Price Drop deals, weekly catalogues, Link card offers, CHAS discounts & more."
  : isGiantPage
    ? "Browse all current Giant supermarket promotions in Singapore. Updated weekly with Super Savings deals, Value Heroes, yuu rewards, CHAS discounts, senior offers & more."
  : `Browse current ${collection.label.toLowerCase()} in Singapore, with links to ${brand?.name || "brand"} outlet pages and full promotion details.`;
const h1 = isShengSiongPage
  ? "Sheng Siong Promotions – Latest Deals"
  : isFairPricePage
    ? "FairPrice Promotions – Latest NTUC FairPrice Deals & Weekly Offers"
    : isGiantPage
      ? "Giant Promotions – Latest Giant Supermarket Deals & Weekly Offers"
    : title;
const heroImage = isShengSiongPage
  ? "/images/sheng-siong-promotions-banner.png"
  : isFairPricePage
    ? "/images/fairpricepromotions-banner.png"
    : isGiantPage
      ? "/images/giantsupermarketpromotions-banner.png"
    : brand?.imageUrl;
const lastUpdatedDate = new Date();
const lastUpdatedIso = lastUpdatedDate.toISOString();
const lastUpdatedLabel = new Intl.DateTimeFormat("en-SG", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "Asia/Singapore"
}).format(lastUpdatedDate);
const shengSiongFaqItems: BrandFaqItem[] = [
  {
    question: "What is the Sheng Siong promotion today?",
    answer:
      "Scroll up to see all currently active Sheng Siong promotions. Each listing shows the promotion name, available validity details from the promotion feed, and a link to the full flyer or promotion page.",
    visibleText:
      "What is the Sheng Siong promotion today?\nScroll up to see all currently active Sheng Siong promotions. Each listing shows the promotion name, available validity details from the promotion feed, and a link to the full flyer or promotion page."
  },
  {
    question: "When does Sheng Siong release new promotions?",
    answer:
      "Sheng Siong commonly releases short-term specials and longer campaign promotions throughout the week. This page is updated whenever new active promotions are added to the promotion feed.",
    visibleText:
      "When does Sheng Siong release new promotions?\nSheng Siong commonly releases short-term specials and longer campaign promotions throughout the week. This page is updated whenever new active promotions are added to the promotion feed."
  },
  {
    question: "Are Sheng Siong promotions available at all outlets?",
    answer:
      "Most catalogue and weekly Sheng Siong promotions apply across Sheng Siong outlets in Singapore, but selected bank, redemption, or product-specific offers may have their own conditions. Always check the promotion detail page or flyer.",
    visibleText:
      "Are Sheng Siong promotions available at all outlets?\nMost catalogue and weekly Sheng Siong promotions apply across Sheng Siong outlets in Singapore, but selected bank, redemption, or product-specific offers may have their own conditions. Always check the promotion detail page or flyer."
  },
  {
    question: "Can I use CDC vouchers at Sheng Siong?",
    answer:
      "Yes. Sheng Siong participates in the CDC supermarket voucher scheme. During special CDC promotion periods, selected products or redemptions may offer additional savings for voucher users.",
    visibleText:
      "Can I use CDC vouchers at Sheng Siong?\nYes. Sheng Siong participates in the CDC supermarket voucher scheme. During special CDC promotion periods, selected products or redemptions may offer additional savings for voucher users."
  },
  {
    question: "Does Sheng Siong have a senior citizen discount?",
    answer:
      "Yes. Sheng Siong offers a senior citizen discount for eligible Singapore shoppers on selected weekdays. Present the required identification at checkout and check in-store terms for the latest conditions.",
    visibleText:
      "Does Sheng Siong have a senior citizen discount?\nYes. Sheng Siong offers a senior citizen discount for eligible Singapore shoppers on selected weekdays. Present the required identification at checkout and check in-store terms for the latest conditions."
  },
  {
    question: "Does Sheng Siong offer CHAS discounts?",
    answer:
      "Yes. Sheng Siong offers CHAS discounts to eligible cardholders on selected weekdays. Present the required physical or digital CHAS card at checkout and check the latest in-store terms.",
    visibleText:
      "Does Sheng Siong offer CHAS discounts?\nYes. Sheng Siong offers CHAS discounts to eligible cardholders on selected weekdays. Present the required physical or digital CHAS card at checkout and check the latest in-store terms."
  }
];
const fairPriceFaqItems: BrandFaqItem[] = [
  {
    question: "What is the NTUC FairPrice promotion today?",
    answer:
      "Scroll up to see all currently active FairPrice promotions with dates and links to each full campaign. The most time-sensitive deals, such as 4-day Neighbourhood Deals and flash specials, are shown first.",
    visibleText:
      "What is the NTUC FairPrice promotion today?\nScroll up to see all currently active FairPrice promotions with dates and links to each full campaign. The most time-sensitive deals, such as 4-day Neighbourhood Deals and flash specials, are shown first."
  },
  {
    question: "When does FairPrice release new weekly promotions?",
    answer:
      "FairPrice updates its weekly catalogue on Thursdays, when new Neighbourhood Deals and Price Drop offers go live. The FairPrice app and website also update weekly ads at the start of each promotional cycle.",
    visibleText:
      "When does FairPrice release new weekly promotions?\nFairPrice updates its weekly catalogue on Thursdays, when new Neighbourhood Deals and Price Drop offers go live. The FairPrice app and website also update weekly ads at the start of each promotional cycle."
  },
  {
    question: "What is the FairPrice Price Drop, Buy Now promotion?",
    answer:
      "Price Drop, Buy Now is FairPrice's main weekly promotions catalogue, featuring discounts of 20% or more on selected products. It includes Must Buy, Weekly Savers, Fresh Buys, and Neighbourhood Deals.",
    visibleText:
      "What is the FairPrice Price Drop, Buy Now promotion?\nPrice Drop, Buy Now is FairPrice's main weekly promotions catalogue, featuring discounts of 20% or more on selected products. It includes Must Buy, Weekly Savers, Fresh Buys, and Neighbourhood Deals."
  },
  {
    question: "How do I earn and use Linkpoints at FairPrice?",
    answer:
      "Linkpoints are earned on qualifying purchases at FairPrice Group outlets using your Link Rewards card or the FairPrice Group app. Points can be converted into cash rebates or used to redeem rewards across the Link ecosystem.",
    visibleText:
      "How do I earn and use Linkpoints at FairPrice?\nLinkpoints are earned on qualifying purchases at FairPrice Group outlets using your Link Rewards card or the FairPrice Group app. Points can be converted into cash rebates or used to redeem rewards across the Link ecosystem."
  },
  {
    question: "Can I use CDC vouchers at FairPrice?",
    answer:
      "Yes. FairPrice is a participating supermarket for the CDC Vouchers scheme. Standard CDC Supermarket Vouchers and SG60 Supermarket Vouchers are redeemable at FairPrice outlets.",
    visibleText:
      "Can I use CDC vouchers at FairPrice?\nYes. FairPrice is a participating supermarket for the CDC Vouchers scheme. Standard CDC Supermarket Vouchers and SG60 Supermarket Vouchers are redeemable at FairPrice outlets."
  },
  {
    question: "Does FairPrice offer senior citizen discounts?",
    answer:
      "Yes. Singaporeans aged 60 and above enjoy discounts on designated days at FairPrice. Present your NRIC or use the FairPrice Group app at checkout. Pioneer Generation and Merdeka Generation cardholders have separate discount schemes.",
    visibleText:
      "Does FairPrice offer senior citizen discounts?\nYes. Singaporeans aged 60 and above enjoy discounts on designated days at FairPrice. Present your NRIC or use the FairPrice Group app at checkout. Pioneer Generation and Merdeka Generation cardholders have separate discount schemes."
  },
  {
    question: "Does FairPrice offer CHAS discounts?",
    answer:
      "Yes. FairPrice offers discounts to CHAS Blue and CHAS Orange cardholders on designated days. Discounts can be auto-applied when you link your CHAS card via MyInfo on the FairPrice Group app.",
    visibleText:
      "Does FairPrice offer CHAS discounts?\nYes. FairPrice offers discounts to CHAS Blue and CHAS Orange cardholders on designated days. Discounts can be auto-applied when you link your CHAS card via MyInfo on the FairPrice Group app."
  },
  {
    question: "What is the difference between FairPrice, FairPrice Finest, and FairPrice Xtra?",
    answer:
      "FairPrice is the standard neighbourhood supermarket format, FairPrice Finest is the premium format with more international and gourmet products, and FairPrice Xtra is the hypermarket format with groceries plus lifestyle categories.",
    visibleText:
      "What is the difference between FairPrice, FairPrice Finest, and FairPrice Xtra?\nFairPrice is the standard neighbourhood supermarket format, FairPrice Finest is the premium format with more international and gourmet products, and FairPrice Xtra is the hypermarket format with groceries plus lifestyle categories."
  }
];
const giantFaqItems: BrandFaqItem[] = [
  {
    question: "What is the Giant supermarket promotion this week?",
    answer:
      "Scroll up to see all currently active Giant promotions with valid dates and links to each full campaign. Weekly Super Savings deals and active flash specials are listed from the dynamic promotion feed.",
    visibleText:
      "What is the Giant supermarket promotion this week?\nScroll up to see all currently active Giant promotions with valid dates and links to each full campaign. Weekly Super Savings deals and active flash specials are listed from the dynamic promotion feed."
  },
  {
    question: "When does Giant release new weekly promotions?",
    answer:
      "Giant typically releases Super Savings weekly specials mid-week, with longer promotions like Value Heroes running for several weeks. Store-exclusive flash deals can appear at any time.",
    visibleText:
      "When does Giant release new weekly promotions?\nGiant typically releases Super Savings weekly specials mid-week, with longer promotions like Value Heroes running for several weeks. Store-exclusive flash deals can appear at any time."
  },
  {
    question: "Does Giant offer senior citizen discounts?",
    answer:
      "Yes. Eligible senior shoppers can receive in-store discounts at Giant on designated days. The shopper must be present and show the required identification at checkout. Check the current listing or in-store terms for the latest conditions.",
    visibleText:
      "Does Giant offer senior citizen discounts?\nYes. Eligible senior shoppers can receive in-store discounts at Giant on designated days. The shopper must be present and show the required identification at checkout. Check the current listing or in-store terms for the latest conditions."
  },
  {
    question: "Does Giant offer CHAS cardholder discounts?",
    answer:
      "Yes. Giant offers in-store discounts to eligible CHAS cardholders on designated days. Present a physical or digital CHAS card at checkout and check the latest terms for exclusions.",
    visibleText:
      "Does Giant offer CHAS cardholder discounts?\nYes. Giant offers in-store discounts to eligible CHAS cardholders on designated days. Present a physical or digital CHAS card at checkout and check the latest terms for exclusions."
  },
  {
    question: "What is the yuu Rewards Club at Giant?",
    answer:
      "yuu Rewards is a multi-brand loyalty programme that lets shoppers earn points at Giant and redeem them across partner brands. Members can also access exclusive yuu deals and bonus point promotions.",
    visibleText:
      "What is the yuu Rewards Club at Giant?\nyuu Rewards is a multi-brand loyalty programme that lets shoppers earn points at Giant and redeem them across partner brands. Members can also access exclusive yuu deals and bonus point promotions."
  },
  {
    question: "What is Giant's Meadows brand?",
    answer:
      "Meadows is Giant's housebrand label for everyday essentials, including fresh and frozen food, pantry items, dairy, cleaning, and personal care products. Meadows items are often featured in weekly promotions.",
    visibleText:
      "What is Giant's Meadows brand?\nMeadows is Giant's housebrand label for everyday essentials, including fresh and frozen food, pantry items, dairy, cleaning, and personal care products. Meadows items are often featured in weekly promotions."
  },
  {
    question: "Can I use CDC vouchers at Giant?",
    answer:
      "Yes. Giant accepts CDC Supermarket Vouchers and SG60 Supermarket Vouchers at its outlets. During special voucher promotion periods, spending vouchers may unlock additional return vouchers or product discounts.",
    visibleText:
      "Can I use CDC vouchers at Giant?\nYes. Giant accepts CDC Supermarket Vouchers and SG60 Supermarket Vouchers at its outlets. During special voucher promotion periods, spending vouchers may unlock additional return vouchers or product discounts."
  },
  {
    question: "What is the difference between Giant supermarket and Giant Hypermarket?",
    answer:
      "Giant neighbourhood supermarkets are smaller-format grocery stores, while Giant Hypermarkets at Tampines and IMM are larger stores with a broader range of products and store-exclusive events or deals.",
    visibleText:
      "What is the difference between Giant supermarket and Giant Hypermarket?\nGiant neighbourhood supermarkets are smaller-format grocery stores, while Giant Hypermarkets at Tampines and IMM are larger stores with a broader range of products and store-exclusive events or deals."
  }
];
const faqSchema = isShengSiongPage
  ? buildFaqPageSchema(shengSiongFaqItems)
  : isFairPricePage
    ? buildFaqPageSchema(fairPriceFaqItems)
    : isGiantPage
      ? buildFaqPageSchema(giantFaqItems)
    : undefined;
---

<Layout title={title} description={description} image={heroImage} canonical={`/${collection.slug}`}>
  {faqSchema && <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

  <section class="container-page py-16" data-pagefind-body data-pagefind-meta={`title:${title};brand:${brand?.name || ""}`}>
    <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-end">
      <div>
        <p class="eyebrow">Promotions</p>
        <h1 class="page-title mt-4">{h1}</h1>
        <p class="page-intro mt-6 max-w-3xl">{description}</p>
        {hasSeoArticle && (
          <p class="mt-5 text-sm font-semibold text-muted">
            Last updated <time datetime={lastUpdatedIso}>{lastUpdatedLabel}</time>
          </p>
        )}
      </div>
      {brand && <a class="fine-link text-sm font-semibold" href={canonicalPath(`/brands/${brand.slug}`)}>{brand.name} brand page</a>}
    </div>

    {isShengSiongPage && (
      <div class="mt-10 overflow-hidden border border-line bg-white">
        <img
          src="/images/sheng-siong-promotions-banner.png"
          alt="Sheng Siong promotions banner with grocery cart and supermarket deals"
          class="aspect-[1823/863] w-full object-cover"
          width="1823"
          height="863"
          loading="eager"
        />
      </div>
    )}

    {isFairPricePage && (
      <div class="mt-10 overflow-hidden border border-line bg-white">
        <img
          src="/images/fairpricepromotions-banner.png"
          alt="FairPrice promotions banner with supermarket deals"
          class="aspect-[1693/929] w-full object-cover"
          width="1693"
          height="929"
          loading="eager"
        />
      </div>
    )}

    {isGiantPage && (
      <div class="mt-10 overflow-hidden border border-line bg-white">
        <img
          src="/images/giantsupermarketpromotions-banner.png"
          alt="Giant supermarket promotions banner with weekly deals"
          class="aspect-[1774/887] w-full object-cover"
          width="1774"
          height="887"
          loading="eager"
        />
      </div>
    )}

    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {promotions.map((promotion) => <PromotionCard promotion={promotion} />)}
    </div>

    {isShengSiongPage && (
      <article class="mt-16 border-t border-line pt-12" aria-labelledby="sheng-siong-promotions-guide">
        <div class="grid gap-10 lg:grid-cols-[0.32fr_1fr] lg:items-start">
          <aside class="border border-line bg-white p-5 text-sm leading-6 text-muted">
            <p class="eyebrow">Guide</p>
            <p class="mt-4">
              Use this page to compare current Sheng Siong deals, then jump to{" "}
              <a class="fine-link font-semibold text-ink" href={canonicalPath(`/brands/${brand?.slug || "Sheng-Siong"}`)}>Sheng Siong outlets</a>{" "}
              or browse all{" "}
              <a class="fine-link font-semibold text-ink" href={canonicalPath("/supermarkets")}>supermarket pages</a>.
            </p>
          </aside>

          <div class="max-w-4xl space-y-12">
            <section>
              <h2 id="sheng-siong-promotions-guide" class="section-title">What are the latest Sheng Siong promotions?</h2>
              <div class="mt-6 space-y-5 text-base leading-8 text-muted">
                <p>
                  Looking for the best Sheng Siong promotions today? This page brings together active Sheng Siong promotions in Singapore, from recurring weekly specials to catalogue deals and card-based discounts.
                </p>
                <p>
                  Sheng Siong is one of Singapore&apos;s most familiar heartland supermarkets, known for competitive prices on fresh produce, household essentials, and pantry staples. The promotion listings above stay connected to the site&apos;s dynamic promotion feed, so offer dates and flyer details come from the latest available records instead of fixed article copy.
                </p>
              </div>
            </section>

            <section>
              <h2 class="section-title">Types of Sheng Siong promotions you&apos;ll find here</h2>
              <div class="mt-7 grid gap-7">
                <section>
                  <h3 class="font-serif text-2xl leading-tight text-ink">4 Days Special</h3>
                  <p class="mt-3 leading-8 text-muted">
                    Sheng Siong&apos;s signature 4 Days Special features limited-time discounts on a rotating selection of grocery products. These offers often highlight everyday snacks, frozen treats, household cleaning products, and pantry essentials.
                  </p>
                </section>
                <section>
                  <h3 class="font-serif text-2xl leading-tight text-ink">Sheng Siong Mega Promotion</h3>
                  <p class="mt-3 leading-8 text-muted">
                    Mega Promotion campaigns usually cover a broader range of categories, from fresh food to personal care. They are useful when you want to stock up on household staples or compare larger supermarket offers.
                  </p>
                </section>
                <section>
                  <h3 class="font-serif text-2xl leading-tight text-ink">CHAS cardholder discounts</h3>
                  <p class="mt-3 leading-8 text-muted">
                    Eligible CHAS cardholders can receive discounts at Sheng Siong by presenting the required physical or digital card at checkout. Check the latest in-store terms before shopping, as eligibility and redemption windows can change.
                  </p>
                </section>
                <section>
                  <h3 class="font-serif text-2xl leading-tight text-ink">Senior citizen discount</h3>
                  <p class="mt-3 leading-8 text-muted">
                    Sheng Siong offers senior citizen discounts for eligible Singapore shoppers on selected weekdays. Bring the required identification and confirm the current terms with the cashier or store notice.
                  </p>
                </section>
                <section>
                  <h3 class="font-serif text-2xl leading-tight text-ink">CDC voucher promotions</h3>
                  <p class="mt-3 leading-8 text-muted">
                    Sheng Siong participates in CDC supermarket voucher schemes. During special CDC promotion periods, selected products or redemptions may carry extra savings for shoppers using eligible vouchers.
                  </p>
                </section>
                <section>
                  <h3 class="font-serif text-2xl leading-tight text-ink">Bank and credit card partnerships</h3>
                  <p class="mt-3 leading-8 text-muted">
                    Sheng Siong periodically works with local banks and card issuers on exclusive cardholder deals. Review each promotion listing for the latest card names, minimum spend, and redemption conditions.
                  </p>
                </section>
              </div>
            </section>

            <section>
              <h2 class="section-title">How to never miss a Sheng Siong promotion</h2>
              <ul class="mt-6 list-disc space-y-3 pl-6 leading-8 text-muted">
                <li>Bookmark this page and check the current promotion listings before your next grocery trip.</li>
                <li>Use the Sheng Siong app to review in-store deals, e-receipts, and nearby store locations.</li>
                <li>Open each promotion detail page for the full flyer, product prices, and terms where available.</li>
                <li>Compare Sheng Siong locations through the linked outlet pages before planning a larger shop.</li>
              </ul>
            </section>

            <section>
              <h2 class="section-title">About Sheng Siong supermarket</h2>
              <div class="mt-6 space-y-5 text-base leading-8 text-muted">
                <p>
                  Sheng Siong is a publicly listed Singapore supermarket chain founded in 1985. With roots as a heartland grocer, it now serves communities across the island through a wide network of outlets.
                </p>
                <p>
                  Sheng Siong promotions are popular with budget-conscious households because they often focus on fresh produce, frozen goods, beverages, toiletries, and everyday essentials. You can use this page alongside the{" "}
                  <a class="fine-link font-semibold text-ink" href={canonicalPath(`/brands/${brand?.slug || "Sheng-Siong"}`)}>Sheng Siong supermarket guide</a>{" "}
                  to move from deals to nearby stores.
                </p>
              </div>
            </section>

            <section>
              <h2 class="section-title">Frequently asked questions</h2>
              <div class="mt-7 divide-y divide-line border-y border-line bg-white">
                {shengSiongFaqItems.map((item) => (
                  <section class="py-6">
                    <h3 class="font-serif text-2xl leading-tight text-ink">{item.question}</h3>
                    <p class="mt-3 leading-8 text-muted">{item.answer}</p>
                  </section>
                ))}
              </div>
            </section>
          </div>
        </div>
      </article>
    )}

    {isFairPricePage && (
      <article class="mt-16 border-t border-line pt-12" aria-labelledby="fairprice-promotions-guide">
        <div class="grid gap-10 lg:grid-cols-[0.32fr_1fr] lg:items-start">
          <aside class="border border-line bg-white p-5 text-sm leading-6 text-muted">
            <p class="eyebrow">Guide</p>
            <p class="mt-4">
              Use this page to compare current NTUC FairPrice deals, then jump to{" "}
              <a class="fine-link font-semibold text-ink" href={canonicalPath(`/brands/${brand?.slug || "FairPrice"}`)}>FairPrice outlets</a>{" "}
              or browse all{" "}
              <a class="fine-link font-semibold text-ink" href={canonicalPath("/supermarkets")}>supermarket pages</a>.
            </p>
          </aside>

          <div class="max-w-4xl space-y-12">
            <section>
              <h2 id="fairprice-promotions-guide" class="section-title">What Are the Latest NTUC FairPrice Promotions?</h2>
              <div class="mt-6 space-y-5 text-base leading-8 text-muted">
                <p>
                  Looking for the best NTUC FairPrice promotions this week? This page tracks active FairPrice promotions in Singapore, from weekly Price Drop catalogues and Everyday Low Price deals to card-based discounts and seasonal campaigns.
                </p>
                <p>
                  NTUC FairPrice is Singapore&apos;s largest supermarket chain, with FairPrice, FairPrice Finest, FairPrice Xtra, and Cheers formats across the island. The promotion listings above stay connected to the site&apos;s dynamic promotion feed, so offer dates and flyer details come from current records instead of fixed article copy.
                </p>
              </div>
            </section>

            <section>
              <h2 class="section-title">Types of NTUC FairPrice Promotions You&apos;ll Find Here</h2>
              <div class="mt-7 grid gap-7">
                <section>
                  <h3 class="font-serif text-2xl leading-tight text-ink">Price Drop, Buy Now</h3>
                  <p class="mt-3 leading-8 text-muted">
                    FairPrice&apos;s flagship weekly promotion features discounts on a rotating selection of products across fresh food, household essentials, frozen goods, personal care, and more. Sub-campaigns can include Must Buy, Weekly Savers, Fresh Buys, and Neighbourhood Deals.
                  </p>
                </section>
                <section>
                  <h3 class="font-serif text-2xl leading-tight text-ink">Everyday Low Price</h3>
                  <p class="mt-3 leading-8 text-muted">
                    Everyday Low Price keeps selected essential items at stable value pricing, helping shoppers save on staples without waiting for a short-term sale.
                  </p>
                </section>
                <section>
                  <h3 class="font-serif text-2xl leading-tight text-ink">Bonus Point Promotions</h3>
                  <p class="mt-3 leading-8 text-muted">
                    FairPrice regularly runs loyalty campaigns where shoppers earn bonus points on qualifying spend, then redeem those points for selected gifts or rewards.
                  </p>
                </section>
                <section>
                  <h3 class="font-serif text-2xl leading-tight text-ink">Stack Up for More Savings &amp; Rewards</h3>
                  <p class="mt-3 leading-8 text-muted">
                    Stack Up promotions layer weekly deals, Linkpoints, member pricing, and card offers so shoppers can combine several saving routes in one grocery trip.
                  </p>
                </section>
                <section>
                  <h3 class="font-serif text-2xl leading-tight text-ink">CHAS Cardholder Discounts</h3>
                  <p class="mt-3 leading-8 text-muted">
                    FairPrice offers regular savings for eligible CHAS cardholders. Check the latest promotion listings for current discount rates, applicable days, and redemption details.
                  </p>
                </section>
                <section>
                  <h3 class="font-serif text-2xl leading-tight text-ink">Pioneer, Merdeka, and Senior Citizen Discounts</h3>
                  <p class="mt-3 leading-8 text-muted">
                    Pioneer Generation, Merdeka Generation, and senior shoppers can enjoy designated discount days. Bring the required card or identification and confirm current terms before checkout.
                  </p>
                </section>
                <section>
                  <h3 class="font-serif text-2xl leading-tight text-ink">NTUC Union Member Deals</h3>
                  <p class="mt-3 leading-8 text-muted">
                    NTUC Union and Link members can access member-exclusive deals by presenting a Link Rewards card or using the FairPrice Group app.
                  </p>
                </section>
                <section>
                  <h3 class="font-serif text-2xl leading-tight text-ink">Trust Bank and Credit Card Promotions</h3>
                  <p class="mt-3 leading-8 text-muted">
                    FairPrice periodically runs bank and cardholder offers, including Trust Bank-linked savings and promotions with local card issuers. Review each listing for spend requirements and terms.
