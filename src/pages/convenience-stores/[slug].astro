---
import Layout from "@/components/Layout.astro";
import ListingCard from "@/components/ListingCard.astro";
import OutletGallery from "@/components/OutletGallery.astro";
import OutletMap from "@/components/OutletMap.astro";
import PromotionCard from "@/components/PromotionCard.astro";
import { getDirectoryData, getFirstInitial, getOutletPromotions, type ConvenienceStore } from "@/lib/airtable";
import { getPrimary, getRelatedByNeighbourhood, splitDescriptionParagraphs } from "@/lib/content";
import { canonicalPath } from "@/lib/seo";
import { getOutletSocialLinks } from "@/lib/social";

export async function getStaticPaths() {
  const data = await getDirectoryData();
  return data.convenienceStores.map((outlet) => ({ params: { slug: outlet.slug }, props: { outlet } }));
}

const { outlet } = Astro.props as { outlet: ConvenienceStore };
const data = await getDirectoryData();
const brand = getPrimary(outlet.brand);
const neighbourhood = getPrimary(outlet.neighbourhood);
const mall = getPrimary(outlet.mall);
const mrt = getPrimary(outlet.mrt);
const related = getRelatedByNeighbourhood(outlet, data.convenienceStores);
const promotions = getOutletPromotions(data.promotions, outlet, 3);
const promotionCollection = brand
  ? data.promotionCollections.find((collection) => collection.brandSlug === brand.slug)
  : undefined;
const title = `${brand?.name ? `${brand.name} ` : ""}${outlet.outletName}`;
const description = outlet.description || `${title} in Singapore${neighbourhood ? `, near ${neighbourhood.name}` : ""}. View address, opening hours, MRT, mall, and contact details.`;
const descriptionParagraphs = splitDescriptionParagraphs(outlet.description);
const initial = getFirstInitial(brand?.name || "", outlet.outletName);
const fullAddress = [outlet.address, outlet.postalCode].filter(Boolean).join(" ");
const socialLinks = getOutletSocialLinks(outlet);
const schema = {
  "@context": "https://schema.org",
  "@type": "ConvenienceStore",
  name: outlet.outletName,
  address: {
    "@type": "PostalAddress",
    streetAddress: outlet.address,
    postalCode: outlet.postalCode,
    addressCountry: "SG"
  },
  telephone: outlet.phone,
  url: outlet.websiteUrl || outlet.googleMapsUrl,
  openingHours: outlet.openingHours
};
---

<Layout title={title} description={description} image={outlet.imageUrl || undefined} canonical={`/convenience-stores/${outlet.slug}`}>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />

  <article
    class="container-page py-12 lg:py-16"
    data-pagefind-body
    data-pagefind-meta={`title:${outlet.outletName};brand:${brand?.name || ""};neighbourhood:${neighbourhood?.name || ""};mrt:${mrt?.name || ""}`}
  >
    <div class="grid gap-10 lg:grid-cols-[0.95fr_1.05fr] lg:items-start">
      <div class="space-y-6">
        <div class="overflow-hidden border border-line bg-white">
          <div class="aspect-[4/3] bg-[#f2efe9]">
            {outlet.imageUrl ? (
              <img src={outlet.imageUrl} alt={`${outlet.outletName} storefront`} class="h-full w-full object-cover" />
            ) : (
              <div class="flex h-full w-full items-center justify-center font-serif text-8xl text-brass">{initial}</div>
            )}
          </div>
          <OutletGallery outletName={outlet.outletName} galleryImagesUrl={outlet.galleryImagesUrl} />
        </div>
        <OutletMap outletName={outlet.outletName} fullAddress={fullAddress} googleMapsUrl={outlet.googleMapsUrl} />
        {outlet.openingHours && (
          <section class="border border-line bg-white p-6">
            <h2 class="font-serif text-3xl">Opening hours</h2>
            <p class="mt-4 whitespace-pre-line leading-7 text-muted">{outlet.openingHours}</p>
          </section>
        )}
        {(outlet.websiteUrl || socialLinks.length > 0) && (
          <section class="border border-line bg-white p-6">
            <h2 class="font-serif text-3xl">Links</h2>
            <div class="mt-4 flex flex-wrap gap-3 text-sm">
              {outlet.websiteUrl && <a class="fine-link" href={outlet.websiteUrl} target="_blank" rel="noreferrer">Website</a>}
              {socialLinks.map((link) => <a class="fine-link" href={link.url} target="_blank" rel="noreferrer">{link.label}</a>)}
            </div>
          </section>
        )}
      </div>

      <div>
        <p class="eyebrow">{brand?.name || "Independent"}</p>
        <h1 class="page-title mt-4">{outlet.outletName}</h1>
        {descriptionParagraphs.length > 0 && (
          <div class="page-intro mt-6 max-w-2xl space-y-6 text-ink">
            {descriptionParagraphs.map((paragraph) => <p class="whitespace-pre-line">{paragraph}</p>)}
          </div>
        )}
        <p class="page-intro mt-6 max-w-2xl">{fullAddress}</p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          {outlet.googleMapsUrl && <a class="soft-button w-full sm:w-auto" href={outlet.googleMapsUrl} target="_blank" rel="noreferrer">Open Google Maps</a>}
          {outlet.websiteUrl && <a class="ghost-button w-full sm:w-auto" href={outlet.websiteUrl} target="_blank" rel="noreferrer">Visit website</a>}
          {outlet.phone && <a class="ghost-button w-full sm:w-auto" href={`tel:${outlet.phone}`}>{outlet.phone}</a>}
        </div>

        <dl class="mt-10 grid gap-5 border-y border-line py-8 sm:grid-cols-2">
          {neighbourhood && (
            <div>
              <dt class="text-xs font-semibold uppercase tracking-[0.16em] text-brass">Neighbourhood</dt>
              <dd class="mt-2"><a class="fine-link" href={canonicalPath(`/neighbourhoods/${neighbourhood.slug}`)}>{neighbourhood.name}</a></dd>
            </div>
          )}
          {mall && (
            <div>
              <dt class="text-xs font-semibold uppercase tracking-[0.16em] text-brass">Mall / Location</dt>
              <dd class="mt-2"><a class="fine-link" href={canonicalPath(`/malls/${mall.slug}`)}>{mall.name}</a></dd>
            </div>
          )}
          {mrt && (
            <div>
              <dt class="text-xs font-semibold uppercase tracking-[0.16em] text-brass">Nearest MRT</dt>
              <dd class="mt-2"><a class="fine-link" href={canonicalPath(`/mrt-stations/${mrt.slug}`)}>{mrt.name} MRT</a></dd>
            </div>
          )}
        </dl>
      </div>
    </div>

  </article>

  {promotions.length > 0 && (
    <section class="border-y border-line bg-white py-16">
      <div class="container-page">
        <div class="flex flex-col justify-between gap-5 md:flex-row md:items-end">
          <div>
            <p class="eyebrow">Promotions</p>
            <h2 class="section-title mt-3">Promotions available at this outlet</h2>
          </div>
          {promotionCollection && <a class="fine-link text-sm font-semibold" href={canonicalPath(`/${promotionCollection.slug}`)}>View current deals at this store</a>}
        </div>
        <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {promotions.map((promotion) => <PromotionCard promotion={promotion} />)}
        </div>
      </div>
    </section>
  )}

  {related.length > 0 && (
    <section class="container-page pb-20">
      <p class="eyebrow">Related</p>
      <h2 class="section-title mt-3">More convenience stores in {neighbourhood?.name}</h2>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {related.map((item) => <ListingCard outlet={item} basePath="/convenience-stores" />)}
      </div>
    </section>
  )}
</Layout>
