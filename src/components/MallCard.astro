---
import type { TaxonomyItem } from "@/lib/airtable";
import { formatCount, hasTaxonomyImage } from "@/lib/content";

interface Props {
  mall: TaxonomyItem;
}

const { mall } = Astro.props;
const showImage = hasTaxonomyImage(mall.imageUrl);
---

<a class="group flex h-full flex-col overflow-hidden border border-line bg-white transition duration-300 hover:-translate-y-1 hover:shadow-editorial" href={`/malls/${mall.slug}`}>
  {
    showImage && (
      <div class="aspect-[4/3] overflow-hidden bg-[#f1eee8]">
        <img
          src={mall.imageUrl}
          alt={`${mall.name} mall`}
          class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
          loading="lazy"
        />
      </div>
    )
  }
  <div class="flex flex-1 flex-col p-4 sm:p-6">
    <p class="text-xs font-semibold uppercase tracking-[0.16em] text-brass">Mall / Location</p>
    <p class="mt-5 font-serif text-2xl leading-tight transition group-hover:text-brass sm:mt-7 sm:text-3xl">{mall.name}</p>
    <p class="mt-auto pt-5 text-sm text-muted">{formatCount(mall.count, "outlet")}</p>
  </div>
</a>
