---
import type { Promotion } from "@/lib/airtable";

interface Props {
  promotion: Promotion;
  linkText?: string;
}

const { promotion, linkText = `View ${promotion.brand.name} promotions` } = Astro.props;
const imageUrl = promotion.imageUrls[0];
---

<article class="group flex h-full flex-col overflow-hidden border border-line bg-white transition duration-300 hover:-translate-y-1 hover:shadow-editorial">
  {
    imageUrl && (
      <a href={promotion.detailPath} class="block">
        <div class="aspect-[4/3] overflow-hidden bg-[#f1eee8]">
          <img
            src={imageUrl}
            alt={`${promotion.title} flyer`}
            class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
            loading="lazy"
          />
        </div>
      </a>
    )
  }
  <div class="flex flex-1 flex-col p-4 sm:p-5">
    <p class="text-xs font-semibold uppercase tracking-[0.16em] text-brass">{promotion.validity || promotion.collectionLabel}</p>
    <h3 class="mt-3 font-serif text-2xl leading-tight">
      <a class="transition hover:text-brass" href={promotion.detailPath}>{promotion.title}</a>
    </h3>
    {promotion.shortDescription && <p class="mt-4 line-clamp-4 text-sm leading-6 text-muted">{promotion.shortDescription}</p>}
    <a class="fine-link mt-auto pt-5 text-sm font-semibold" href={promotion.detailPath}>{linkText}</a>
  </div>
</article>
