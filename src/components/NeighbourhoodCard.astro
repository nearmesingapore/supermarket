---
import type { TaxonomyItem } from "@/lib/airtable";
import { formatCount } from "@/lib/content";

interface Props {
  neighbourhood: TaxonomyItem;
}

const { neighbourhood } = Astro.props;
---

<a class="group block border border-line bg-white p-6 transition duration-300 hover:-translate-y-1 hover:shadow-editorial" href={`/neighbourhoods/${neighbourhood.slug}`}>
  <p class="font-serif text-3xl leading-tight transition group-hover:text-brass">{neighbourhood.name}</p>
  <p class="mt-5 text-sm text-muted">{formatCount(neighbourhood.count, "outlet")}</p>
</a>
