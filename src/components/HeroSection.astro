---
import SearchBox from "./SearchBox.astro";
---

<section class="border-b border-line bg-paper">
  <div class="container-page grid min-h-[calc(76dvh-4rem)] content-center gap-10 py-12 sm:py-16 lg:min-h-[calc(86dvh-4rem)] lg:grid-cols-[1.05fr_0.95fr] lg:py-24">
    <div>
      <p class="eyebrow">Singapore Supermarket Directory</p>
      <h1 class="mt-6 max-w-full font-serif text-[clamp(3rem,15vw,4rem)] leading-[1.02] text-ink sm:max-w-4xl sm:text-7xl lg:text-8xl">Discover Supermarkets Across Singapore</h1>
      <p class="page-intro mt-6 max-w-2xl sm:mt-7">Your guide to every supermarket, by neighbourhood, brand, and mall.</p>
      <div class="mt-10"><SearchBox /></div>
    </div>
    <div class="relative hidden min-h-[520px] lg:block" aria-hidden="true">
      <div class="absolute left-6 top-4 h-64 w-72 border border-line bg-white p-6 shadow-editorial"><p class="eyebrow">Browse</p><p class="mt-16 font-serif text-5xl leading-none">By neighbourhood</p></div>
      <div class="absolute right-0 top-28 h-72 w-80 border border-line bg-[#f4f0ea] p-8 shadow-editorial"><p class="font-serif text-6xl leading-none">430+</p><p class="mt-5 text-sm uppercase tracking-[0.18em] text-muted">Published outlets</p></div>
      <div class="absolute bottom-6 left-16 h-60 w-80 border border-line bg-white p-7 shadow-editorial"><p class="text-sm font-semibold text-brass">Curated, searchable, static.</p><p class="mt-10 text-2xl leading-snug">A refined guide for everyday grocery discovery.</p></div>
    </div>
  </div>
</section>
