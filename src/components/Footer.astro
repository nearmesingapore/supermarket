---
import { canonicalPath } from "@/lib/seo";

const links = [
  { href: "/directory", label: "Directory" },
  { href: "/brands", label: "Brands" },
  { href: "/neighbourhoods", label: "Neighbourhoods" },
  { href: "/malls", label: "Malls" },
  { href: "/mrt-stations", label: "MRT Stations" },
  { href: "/sheng-siong-promotions", label: "Sheng Siong Promotions" },
  { href: "/fairprice-promotions", label: "FairPrice Promotions" },
  { href: "/giant-promotions", label: "Giant Promotions" },
  { href: "/search", label: "Search" }
].map((link) => ({ ...link, href: canonicalPath(link.href) }));
---

<footer class="mt-24 border-t border-line bg-white">
  <div class="container-page grid gap-8 py-12 md:grid-cols-[1.2fr_0.8fr]">
    <div>
      <p class="font-serif text-3xl">SG Supermarkets</p>
      <p class="mt-3 max-w-xl text-sm leading-6 text-muted">
        A curated directory of supermarket outlets across Singapore, built for fast discovery by neighbourhood, brand, mall, and MRT station.
      </p>
    </div>
    <nav class="grid grid-cols-2 gap-3 text-sm text-muted sm:grid-cols-3 md:justify-self-end" aria-label="Footer navigation">
      {links.map((link) => <a class="fine-link" href={link.href}>{link.label}</a>)}
    </nav>
  </div>
</footer>
