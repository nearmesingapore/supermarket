---
import type { DirectoryData, LinkedItem, Supermarket, TaxonomyItem } from "@/lib/airtable";

interface Props {
  data: DirectoryData;
  outlets: Supermarket[];
}

const { data, outlets } = Astro.props;

const filterTaxonomy = (items: TaxonomyItem[], readLinks: (outlet: Supermarket) => LinkedItem[]) => {
  const ids = new Set(outlets.flatMap((outlet) => readLinks(outlet).map((item) => item.id)));
  return items.filter((item) => ids.has(item.id));
};

const neighbourhoods = filterTaxonomy(data.neighbourhoods, (outlet) => outlet.neighbourhood);
const brands = filterTaxonomy(data.brands, (outlet) => outlet.brand);
const mrtStations = filterTaxonomy(data.mrtStations, (outlet) => outlet.mrt);
const malls = filterTaxonomy(data.malls, (outlet) => outlet.mall);
const categories = [...new Set(outlets.map((outlet) => outlet.category).filter(Boolean))]
  .sort((a, b) => a.localeCompare(b));
---

<section class="border border-line bg-white p-4 sm:p-5" aria-label="Directory filters" data-filter-bar>
  <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
    <label class="text-sm font-medium text-ink">
      <span class="mb-2 block">Neighbourhood</span>
      <select class="filter-field min-h-11 w-full rounded-none border border-line bg-white px-3 text-sm" data-filter="neighbourhood">
        <option value="">All</option>
        {neighbourhoods.map((item) => <option value={item.slug}>{item.name}</option>)}
      </select>
    </label>
    <label class="text-sm font-medium text-ink">
      <span class="mb-2 block">Brand</span>
      <select class="filter-field min-h-11 w-full rounded-none border border-line bg-white px-3 text-sm" data-filter="brand">
        <option value="">All</option>
        {brands.map((item) => <option value={item.slug}>{item.name}</option>)}
      </select>
    </label>
    <label class="text-sm font-medium text-ink">
      <span class="mb-2 block">Category</span>
      <select class="filter-field min-h-11 w-full rounded-none border border-line bg-white px-3 text-sm" data-filter="category">
        <option value="">All</option>
        {categories.map((item) => <option value={item}>{item}</option>)}
      </select>
    </label>
    <label class="text-sm font-medium text-ink">
      <span class="mb-2 block">Nearest MRT</span>
      <select class="filter-field min-h-11 w-full rounded-none border border-line bg-white px-3 text-sm" data-filter="mrt">
        <option value="">All</option>
        {mrtStations.map((item) => <option value={item.slug}>{item.name}</option>)}
      </select>
    </label>
    <label class="text-sm font-medium text-ink">
      <span class="mb-2 block">Mall</span>
      <select class="filter-field min-h-11 w-full rounded-none border border-line bg-white px-3 text-sm" data-filter="mall">
        <option value="">All</option>
        {malls.map((item) => <option value={item.slug}>{item.name}</option>)}
      </select>
    </label>
  </div>
  <div class="mt-5 flex flex-wrap items-center justify-between gap-3">
    <p id="filter-count" class="text-sm text-muted">{outlets.length} outlets shown</p>
    <button id="filter-reset" class="ghost-button" type="button">Reset filters</button>
  </div>
  <p id="filter-empty" class="mt-4 hidden text-sm text-muted">No outlets match these filters.</p>
</section>

<script>
  import { cardMatchesFilters } from "@/lib/directoryFilters";

  const root = document.querySelector<HTMLElement>("[data-filter-bar]");
  const results = document.querySelector<HTMLElement>("[data-filter-results]");

  if (root && results) {
    const fields = Array.from(root.querySelectorAll<HTMLSelectElement>(".filter-field"));
    const cards = Array.from(results.querySelectorAll<HTMLElement>("[data-card]"));
    const count = root.querySelector<HTMLElement>("#filter-count");
    const reset = root.querySelector<HTMLButtonElement>("#filter-reset");
    const empty = root.querySelector<HTMLElement>("#filter-empty");

    function applyFilters() {
      const active = fields
        .map((field) => [field.dataset.filter || "", field.value] as const)
        .filter(([, value]) => value);
      let visible = 0;

      for (const card of cards) {
        const matches = cardMatchesFilters(card.dataset, active);
        card.hidden = !matches;
        if (matches) visible += 1;
      }

      if (count) count.textContent = `${visible} ${visible === 1 ? "outlet" : "outlets"} shown`;
      empty?.classList.toggle("hidden", visible !== 0);
    }

    fields.forEach((field) => {
      field.addEventListener("input", applyFilters);
      field.addEventListener("change", applyFilters);
    });
    applyFilters();
    reset?.addEventListener("click", () => {
      fields.forEach((field) => {
        field.value = "";
      });
      applyFilters();
    });
  }
</script>
