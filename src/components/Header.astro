---
const links = [
  { href: "/", label: "Home" },
  { href: "/directory", label: "Directory" },
  { href: "/supermarkets", label: "Supermarkets" },
  { href: "/grocery-stores", label: "Grocery Stores" },
  { href: "/search", label: "Search" }
];

const promotionMenu = { href: "/promotions", label: "Promotions" };
const promotionLinks = [
  { href: "/sheng-siong-promotions", text: "Sheng Siong Promotions" },
  { href: "/fairprice-promotions", text: "FairPrice Promotions" },
  { href: "/giant-promotions", text: "Giant Promotions" }
];
---

<header class="sticky top-0 z-40 border-b border-line bg-paper/95 backdrop-blur">
  <div class="container-page flex min-h-16 items-center justify-between gap-4 py-3">
    <a href="/" class="shrink-0 font-serif text-2xl leading-none text-ink" aria-label="Singapore Supermarket Directory home">
      SG Supermarkets
    </a>
    <nav class="hidden items-center gap-3 text-xs font-medium text-muted md:flex xl:gap-4 xl:text-sm" aria-label="Primary navigation">
      {links.slice(0, 4).map((link) => (
        <a class="transition hover:text-ink" href={link.href}>{link.label}</a>
      ))}
      <details class="group relative">
        <summary class="flex cursor-pointer list-none items-center gap-1 transition hover:text-ink">
          <span>{promotionMenu.label}</span>
          <span aria-hidden="true" class="text-[0.65rem] transition group-open:rotate-180">⌄</span>
        </summary>
        <div class="absolute left-1/2 top-full z-50 mt-3 w-64 -translate-x-1/2 border border-line bg-white p-3 shadow-editorial">
          <div class="grid gap-1">
            <a class="block px-3 py-2 transition hover:bg-paper hover:text-ink" href={promotionMenu.href}>All Promotions</a>
            {promotionLinks.map((link) => (
              <a class="block px-3 py-2 transition hover:bg-paper hover:text-ink" href={link.href}>{link.text}</a>
            ))}
          </div>
        </div>
      </details>
      {links.slice(4).map((link) => (
        <a class="transition hover:text-ink" href={link.href}>{link.label}</a>
      ))}
    </nav>
    <a href="/directory" class="ghost-button hidden sm:inline-flex">Browse</a>
    <button
      class="inline-flex min-h-12 min-w-12 items-center justify-center rounded-full border border-line bg-white text-ink md:hidden"
      type="button"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-toggle
    >
      <span class="sr-only">Menu</span>
      <span aria-hidden="true" class="flex flex-col gap-1.5">
        <span class="block h-0.5 w-5 bg-current"></span>
        <span class="block h-0.5 w-5 bg-current"></span>
        <span class="block h-0.5 w-5 bg-current"></span>
      </span>
    </button>
  </div>
  <nav id="mobile-menu" class="container-page hidden border-t border-line py-3 md:hidden" aria-label="Mobile navigation" data-menu-panel>
    <div class="grid gap-2 text-sm font-medium text-muted">
      {links.slice(0, 4).map((link) => (
        <a class="block rounded-full bg-white px-4 py-3 transition hover:text-ink" href={link.href}>{link.label}</a>
      ))}
      <details class="rounded-3xl bg-white px-4 py-3">
        <summary class="cursor-pointer list-none text-ink">{promotionMenu.label}</summary>
        <div class="mt-3 grid gap-2 border-t border-line pt-3">
          <a class="block transition hover:text-ink" href={promotionMenu.href}>All Promotions</a>
          {promotionLinks.map((link) => (
            <a class="block transition hover:text-ink" href={link.href}>{link.text}</a>
          ))}
        </div>
      </details>
      {links.slice(4).map((link) => (
        <a class="block rounded-full bg-white px-4 py-3 transition hover:text-ink" href={link.href}>{link.label}</a>
      ))}
    </div>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const panel = document.querySelector<HTMLElement>("[data-menu-panel]");

  toggle?.addEventListener("click", () => {
    const isOpen = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!isOpen));
    panel?.classList.toggle("hidden", isOpen);
  });
</script>
